def DoubleLadder.ylad : (m : ℕ) → Matrix (Line m) (Line m) ℤ :=
fun m =>
  Matrix.of fun p q =>
    if p.1 = q.1 then
      ((((if p.2.1 = q.2.1 then 1 else 0) + if p.2.2 = q.2.2 then 1 else 0) +
            3 * if p.2.1 - p.2.2 = q.2.1 - q.2.2 then 1 else 0) +
          3 * if p.2.1 + p.2.2 = q.2.1 + q.2.2 then 1 else 0) -
        if p = q then 6 * ↑m else 0
    else 0
