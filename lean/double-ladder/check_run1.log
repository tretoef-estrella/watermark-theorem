gram_mul_ylad_mul_gram : ∀ (m : ℕ) [inst : Fact (Nat.Prime m)], 5 ≤ m → gram m * ylad m * gram m = (6 * ↑m ^ 2) • gram m
exists_toMatrix_mul_eq : ∀ (m : ℕ) [inst : Fact (Nat.Prime m)],
