@gram_transpose : ∀ {m : ℕ}, (gram m).transpose = gram m
@gram_mulVec_famVec : ∀ {m : ℕ} [inst : NeZero m] (j : Fin 3), (gram m).mulVec (famVec m j) = ↑m • ones m
@sum_E_pencil : ∀ {m : ℕ} [inst : NeZero m] [Fact (Nat.Prime m)] (u : Point m → ℤ) (p : Point m),
  ∑ π, E (pencil π) u p = ↑m * u p + ∑ q, u q
@aug_of_mem_K : ∀ {m : ℕ} [inst : NeZero m] [Fact (Nat.Prime m)],
  5 ≤ m →
    ∀ {x : A m},
      x ∈ K m →
        aug (restrict x 0) + aug (restrict x 1) + aug (restrict x 2) = 0 ∧ ∀ (j : Fin 3), ↑m ∣ aug (restrict x j)
@sum_eq_zero_of_mem_K : ∀ {m : ℕ} [inst : NeZero m] {x : A m}, x ∈ K m → ∑ p, x p = 0
formV : (m : ℕ) → [inst : NeZero m] → LinearMap.BilinForm ℤ (V m)
